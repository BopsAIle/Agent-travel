OPENAI_REASONING_EFFORT=low
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
TAVILY_API_KEY=
RAPIDAPI_KEY=
TICKETMASTER_API_KEY=
DATABASE_URL=postgresql://travel:travel@localhost:5432/travel_agent
JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=72

GEMINI_MODEL=gemini-2.5-flash

# Dia chi microservice (mac dinh dung ten service trong docker-compose)
FLIGHT_SERVICE_URL=http://flight-service:8000
HOTEL_SERVICE_URL=http://hotel-service:8001
ACTIVITY_SERVICE_URL=http://activity-service:8002
GEOCODING_SERVICE_URL=http://geocoding-service:8003
EVENT_SERVICE_URL=http://event-service:8004

# Thu muc ghi trip_itinerary.md / .html
OUTPUT_DIR=output

# True = tra loi gia lap, khong goi LLM (dung cho load test)
MOCK_MODE=False
