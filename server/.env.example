OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
TAVILY_API_KEY=
RAPIDAPI_KEY=
TICKETMASTER_API_KEY=
DATABASE_URL=postgresql://travel:travel@localhost:5432/travel_agent
# Sinh khoa that roi dan vao server/.env:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# De trong = dung khoa dev mac dinh va se co canh bao luc khoi dong.
JWT_SECRET=
JWT_EXPIRE_HOURS=72

GEMINI_MODEL=gemini-2.5-flash

# Embedding cho memory. text-embedding-004 đã bị Google tắt ngày 14/01/2026, đổi sang
# gemini-embedding-001 (còn hỗ trợ tới 14/05/2028). GEMINI_EMBED_DIM phải khớp
# EMBEDDING_DIM trong app/db/models.py (cột Vector 768 chiều).
GEMINI_EMBED_MODEL=models/gemini-embedding-001
GEMINI_EMBED_DIM=768

# Dia chi microservice (mac dinh dung ten service trong docker-compose)
FLIGHT_SERVICE_URL=http://flight-service:8000
HOTEL_SERVICE_URL=http://hotel-service:8001
ACTIVITY_SERVICE_URL=http://activity-service:8002
GEOCODING_SERVICE_URL=http://geocoding-service:8003
EVENT_SERVICE_URL=http://event-service:8004

# Thu muc ghi report: reports/<session_id>.md|.html cho tung phien,
# va trip_itinerary.md|.html la ban moi nhat (co the bi ghi de)
OUTPUT_DIR=output

# True = tra loi gia lap, khong goi LLM (dung cho load test)
MOCK_MODE=False
